# Local dev (Expo Go on same Wi‑Fi as your PC)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# Map provider — google (default in development) or maplibre (production).
# 'google' uses react-native-maps and requires a native rebuild
# (npx expo run:android) with EXPO_PUBLIC_GOOGLE_MAPS_API_KEY set below.
# EXPO_PUBLIC_MAP_PROVIDER=maplibre

# MapLibre — optional override for the dark map style (defaults to CARTO dark-matter)
# EXPO_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Google Maps — SDK key baked into the Android/iOS manifests for dev builds
# when EXPO_PUBLIC_MAP_PROVIDER=google. Rebuild the app after changing it.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sign-In — native in-app picker (like Bolt). Requires a dev/release build,
# not Expo Go. Android needs its OAuth client registered with the SHA-1 of every
# signing certificate used to build the APK/AAB (debug, EAS preview, production).
#
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth client: Web application → copy ID to EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
#    It is the token audience verified by the backend.
# 3. Create OAuth client: Android → package com.ufundi.uganda + your app SHA-1 fingerprint.
#    Get SHA-1: cd mobile && npx @react-native-google-signin/config-doctor
#    Local debug builds of THIS repo sign with mobile/android/app/debug.keystore,
#    whose SHA-1 is: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
#    EAS builds use EAS's own keystore — register that SHA-1 too (eas credentials).
# 4. Rebuild the app: cd mobile && npx expo run:android
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Required when enabling iOS: use the reversed iOS OAuth-client ID from Google.
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxx
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- EAS build / Expo Update (phones anywhere) ---
# The APK cannot use localhost or LAN IP. Deploy the backend first, then set
# the public URL in mobile/eas.json (preview + production env) OR:
#
#   cd mobile
# npx eas-cli env:create --name EXPO_PUBLIC_API_URL --value https://ufundi1.onrender.com/api --environment preview
