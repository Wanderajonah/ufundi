PORT=5000
# Supabase project config (Project Settings > API). The backend uses the
# service role key so RLS never blocks it (never expose it to clients).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Supabase Postgres connection string (Project Settings > Database). Used by
# `npm run migrate` to apply sql/schema.sql.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=<random-secret>
OPENAI_API_KEY=
# Set COMMS_DEV_MODE=true ONLY in development: OTP codes are logged instead of
# sent and returned in the API response. Must be false in production.
COMMS_DEV_MODE=false
COMMS_ENDPOINT=https://comms.egosms.co/api/v1/json/
COMMS_USERNAME=
COMMS_API_KEY=
COMMS_SENDER_ID=FundiLink
# Optional SMS gateway timeout in ms (default 10000)
COMMS_TIMEOUT_MS=10000
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=qwen/qwen3.6-27b
AI_BRAND_NAME=FundiLink
